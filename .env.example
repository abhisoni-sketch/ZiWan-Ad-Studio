# ==========================================
# Google Cloud Platform Configuration
# ==========================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
DEFAULT_LOCATION=asia-south1
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# GCS Storage Buckets (Optional Overrides)
# ==========================================
GCS_MOUNT_PATH=/tmp/
# INGEST_BUCKET=your-custom-ingest-bucket
# OUTPUT_BUCKET=your-custom-output-bucket

# ==========================================
# AI Model Selection (Optional Overrides)
# ==========================================
DEFAULT_MODEL=gemini-3.1-pro-preview
DEFAULT_TEXT_MODEL=gemini-3.1-pro-preview
DEFAULT_VIDEO_MODEL=gemini-omni-flash-preview
DEFAULT_TTS_MODEL=gemini-3.1-flash-tts-preview
DEFAULT_BGM_MODEL=lyria-3-pro-preview

# ==========================================
# Product Catalog Anomaly Mappings (JSON format)
# ==========================================
PRODUCT_ALIASES={"ACCG7YFMFQQTM93Z": "ACCGJYHMFUKZ2V5N", "RFRHJ4JJPA4UBHGZ": "WMNH2DJCJASPFZE2"}
